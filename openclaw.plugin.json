{
  "id": "openclaw-onebot-hook",
  "name": "OneBot Reliable Hook",
  "version": "0.1.0",
  "description": "OneBot v11 channel plugin that forwards inbound messages and delivers OpenClaw replies in the service layer, without agent tools or skills.",
  "author": "OpenClaw Ret Onebot",
  "channels": ["onebot"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "onebot": {
      "label": "OneBot Reliable Hook",
      "description": "OneBot v11 reliable service-level hook channel.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the OneBot hook channel."
          },
          "ws": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["forward", "reverse"],
                "default": "forward",
                "description": "forward connects to OneBot WebSocket; reverse listens for OneBot reverse WebSocket."
              },
              "url": {
                "type": "string",
                "description": "Forward WebSocket URL, for example ws://127.0.0.1:3001/onebot/v11/ws."
              },
              "listenHost": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "Reverse WebSocket listen host."
              },
              "listenPort": {
                "type": "number",
                "default": 3002,
                "description": "Reverse WebSocket listen port."
              },
              "path": {
                "type": "string",
                "default": "/onebot/v11/ws",
                "description": "Reverse WebSocket path."
              }
            },
            "description": "OneBot WebSocket receive/API fallback configuration."
          },
          "httpUrl": {
            "type": "string",
            "description": "OneBot HTTP API root, for example http://127.0.0.1:3001. Recommended for reliable sends."
          },
          "accessToken": {
            "type": "string",
            "description": "OneBot access token."
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "private": {
                "type": "string",
                "enum": ["all"],
                "default": "all"
              },
              "group": {
                "type": "string",
                "enum": ["mention_or_keyword"],
                "default": "mention_or_keyword"
              },
              "keywords": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "stripMention": {
                "type": "boolean",
                "default": true
              }
            },
            "description": "Private messages always trigger; group messages require mention or keyword."
          },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Allowed senders or groups, for example user:123 or group:456. Empty means allow all."
          },
          "denyFrom": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Denied senders or groups, for example user:123 or group:456."
          },
          "reply": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["chunked"],
                "default": "chunked"
              },
              "flushIntervalMs": {
                "type": "number",
                "default": 1200
              },
              "flushChars": {
                "type": "number",
                "default": 160
              },
              "markdownToPlain": {
                "type": "boolean",
                "default": true
              },
              "maxRetries": {
                "type": "number",
                "default": 3
              }
            },
            "description": "Reliable reply delivery settings."
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "downloadInboundImages": {
                "type": "boolean",
                "default": true
              },
              "cacheDir": {
                "type": "string",
                "default": "~/.openclaw/media/onebot"
              },
              "maxImageBytes": {
                "type": "number",
                "default": 15000000
              },
              "downloadTimeoutMs": {
                "type": "number",
                "default": 10000
              },
              "retainHours": {
                "type": "number",
                "default": 24
              },
              "outboundMode": {
                "type": "string",
                "enum": ["segments"],
                "default": "segments"
              },
              "markdownImages": {
                "type": "boolean",
                "default": true
              },
              "maxImagesPerReply": {
                "type": "number",
                "default": 6
              }
            },
            "description": "Inbound image caching and outbound OneBot media segment settings."
          }
        }
      },
      "uiHints": {
        "accessToken": { "label": "Access Token", "sensitive": true },
        "httpUrl": { "label": "HTTP API URL", "placeholder": "http://127.0.0.1:3001" },
        "ws.url": { "label": "WebSocket URL", "placeholder": "ws://127.0.0.1:3001/onebot/v11/ws" }
      }
    }
  },
  "uiHints": {
    "accessToken": { "label": "Access Token", "sensitive": true },
    "httpUrl": { "label": "HTTP API URL", "placeholder": "http://127.0.0.1:3001" },
    "ws.url": { "label": "WebSocket URL", "placeholder": "ws://127.0.0.1:3001/onebot/v11/ws" }
  }
}
